version: v1alpha1
metadata:
  name: router
  version: "{{ .VERSION }}"
  author: slipmesh
  description: |
    Talos extension service: renders BIRD config (OSPFv3 over mesh links, full-mesh iBGP
    over loopbacks) and resolves bypass-route prefixes from a static config file,
    supervising a bundled bird built from upstream. No kernel module - pure userspace.
  compatibility:
    talos:
      version: ">= v1.10.0"
