# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line.

# --- Talos --------------------------------------------------------------------------
# Which siderolabs/talos tag to check out (for its own `make kernel initramfs` recipe)
# and which stock installer/imager version to use as the base. Must match whatever
# TALOS_VERSION the kernel (KERNEL_IMAGE, passed at `make installer` time) and every
# extension in EXTENSIONS were built against - this repo doesn't enforce that; mismatches
# show up as a node that doesn't boot or an extension that fails Talos's own version
# compatibility check, not a build-time error here.
TALOS_VERSION=v1.13.8

# --- where the artifacts go -------------------------------------------------------
IMAGE=docker.io/ffaxl/talos
